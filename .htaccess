# ==========================================================
#  القدس للمجوهرات - سامح القدس
#  إعدادات السيرفر: ضمان خدمة الصور بأنواعها الصحيحة
# ==========================================================

# --- 1. أنواع MIME للصور ---
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType image/jpeg .jpg .jpeg
  AddType image/svg+xml .svg
  AddType text/css .css
  AddType application/javascript .js
</IfModule>

# --- 2. منع اعتراض الصور (hotlink protection may block same-origin) ---
<IfModule mod_headers.c>
  <FilesMatch "\.(webp|jpg|jpeg|png|svg|css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
    # السماح بالعرض داخل الموقع نفسه
    Header set Access-Control-Allow-Origin "*"
    # إزالة أي ترويسة قد تُربك المتصفح
    Header unset Content-Encoding
  </FilesMatch>
</IfModule>

# --- 3. تعطيل أي معالجة قد تفشل ---
<IfModule mod_rewrite.c>
  RewriteEngine On
  # ضمان عدم تحويل ملفات الصور أو الأصول الثابتة إلى صفحات HTML (ناتج عن JS challenge أو SPA fallback)
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule \.(webp|jpg|jpeg|png|svg|css|js|woff2)$ - [L]

  # منع أي إعادة كتابة لمسار images أو الأصول
  RewriteRule ^(images|assets)/ - [L]
</IfModule>

# --- 4. صفحة الخطأ الافتراضية ---
ErrorDocument 404 /index.html

# --- 5. ضغط الملفات النصية ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>
